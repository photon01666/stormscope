# Rust build output
/target

# Downloaded NEXRAD fixtures (real radar volumes, several MB each)
/crates/radar-decode/tests/fixtures/*
!/crates/radar-decode/tests/fixtures/.gitignore
!/crates/radar-decode/tests/fixtures/download.sh

# Sample GOES GLM NetCDF pulled from the public AWS bucket while testing the
# lightning decoder. It is a downloaded data file, not source.
glm.nc

# Local screenshot scratch (ad-hoc captures used to verify a change must not
# be committed — the README's deliberate images live under docs/)
/overlay*.png
/screenshot*.png

# Editor / OS cruft
*.swp
.DS_Store

# Personal app state — map pins, preferred site, UI prefs. These are the
# user's own config (normally written to ~/.config/stormscope, outside the
# repo), but keep them out of commits even if one lands in the work tree.
markers.json
prefs.json
site.json
*.persist
