<?xml version="1.0" encoding="utf-8"?>
<!-- Persistent Storm Watch notification: animated current-conditions glyph
     and a large weather line. No title or background, so it blends into the
     system notification surface. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <ViewFlipper
        android:id="@+id/storm_watch_flipper"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:autoStart="true"
        android:flipInterval="700"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <ImageView
            android:id="@+id/storm_watch_icon_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/storm_watch_weather_icon"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/storm_watch_icon_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/storm_watch_weather_icon"
            android:scaleType="fitCenter" />
    </ViewFlipper>

    <TextView
        android:id="@+id/storm_watch_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="#FFFFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />
</LinearLayout>
